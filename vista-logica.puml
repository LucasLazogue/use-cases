@startuml vista-logica
' ---------------------------------------------------------------------------
' carga.uy - Vista Logica, Arquitectura General del Sistema
' Laboratorio TSE 2026 - SAD seccion 6.1 (Figura 4)
'
' Los subsistemas del componente central salen de la Seccion 2 y de los
' titulos de la Seccion 3 de la letra:
'   3.1 Ciudadanos - Frontoffice (publico)  \ un unico Frontoffice Ciudadanos
'   3.2 Ciudadanos - Frontoffice            /
'   3.3 Ciudadanos - Componente Movil        -> fuera del central
'   3.4 Funcionarios - Frontoffice           -> Frontoffice Funcionarios
'   3.5 Fiscalizacion Automatica             -> Fiscalizacion Automatica
'   3.6 Autoridades y Administradores -
'       Backoffice                           -> un unico Backoffice, por rol
'   RNF 4.1.2: el movil consume Web Services REST del central
'
' Como en la Figura 4 de la plantilla: sin etiquetas de protocolo, sin
' comunicacion entre las cajas internas y sin infraestructura (broker,
' persistencia y observabilidad van en 6.2-6.4 y en la seccion 7).
' ---------------------------------------------------------------------------

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam roundcorner 0
skinparam ArrowColor #000000
skinparam ArrowFontColor #000000
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}

' =========================== actores ===========================
actor "Publico general /\nempresa cliente" as PUB
actor "Responsable\nde empresa" as RESP
actor "Funcionario" as FUNC
actor "Autoridad" as AUT
actor "Administrador" as ADM
actor "Chofer" as CHOF

' =========================== componente movil ===========================
rectangle "<<subsystem>>\nComponente Movil" as MOV

' =========================== componente central ===========================
rectangle "<<subsystem>>\ncomponente central" as CENTRAL {
  rectangle "<<subsystem>>\nFrontoffice\nCiudadanos" as FOCIU
  rectangle "<<subsystem>>\nFrontoffice\nFuncionarios" as FOFUN
  rectangle "<<subsystem>>\nBackoffice" as BACK
  rectangle "<<subsystem>>\nServicios REST" as API
  rectangle "<<subsystem>>\nFiscalizacion\nAutomatica" as FISCA
}

' =========================== subsistemas perifericos ===========================
rectangle "<<subsystem>>\nNodo Periferico\nBalanzas" as NBAL
rectangle "<<subsystem>>\nNodo Periferico\nTracking" as NTRK
rectangle "<<subsystem>>\nSimulador PDI" as SPDI
rectangle "<<actor>>\nUsuario gub.uy" as GUB

' grilla dentro del central
FOCIU -[hidden]right- FOFUN
FOFUN -[hidden]right- BACK
FOCIU -[hidden]down- API
API -[hidden]right- FISCA

' =========================== asociaciones ===========================
PUB --> FOCIU
RESP --> FOCIU
FUNC --> FOFUN
AUT --> BACK
ADM --> BACK
CHOF --> MOV

MOV --> API

NBAL --> CENTRAL
NTRK --> CENTRAL
SPDI --> CENTRAL
GUB --> CENTRAL

@enduml
