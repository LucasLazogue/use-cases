@startuml vista-logica
' ---------------------------------------------------------------------------
' carga.uy - Vista Logica, Arquitectura General del Sistema
' Laboratorio TSE 2026 - SAD seccion 6.1 (Figura 4)
'
' Sigue la Figura 4 de la plantilla (sad_tse_2025.pdf):
'   - el componente central contiene los subsistemas funcionales
'   - los actores y los subsistemas externos apuntan HACIA el central
'   - sin etiquetas de protocolo: como se comunican es 4.1 y la vista de
'     distribucion, no esta vista
'   - sin comunicacion dibujada entre las cajas internas: eso es 6.2-6.4
'
' El broker, la persistencia y la plataforma de observabilidad no aparecen
' aca: son infraestructura, y van en los refinamientos y en la seccion 7.
' ---------------------------------------------------------------------------

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam roundcorner 0
skinparam ArrowColor #000000
skinparam ArrowFontColor #000000
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}

' =========================== actores ===========================
actor "Publico general /\nempresa cliente" as PUB
actor "Responsable\nde empresa" as RESP
actor "Chofer" as CHOF
actor "Funcionario" as FUNC
actor "Autoridad" as AUT
actor "Administrador" as ADM

' =========================== componente movil ===========================
rectangle "<<subsystem>>\nMovil" as MOV

' =========================== componente central ===========================
rectangle "<<subsystem>>\ncomponente central" as CENTRAL {
  rectangle "<<subsystem>>\nFrontoffice\nPublico" as FOPUB
  rectangle "<<subsystem>>\nFrontoffice\nEmpresas" as FOEMP
  rectangle "<<subsystem>>\nFrontoffice\nFiscalizacion" as FOFIS
  rectangle "<<subsystem>>\nBackoffice\nAutoridades" as BOAUT
  rectangle "<<subsystem>>\nBackoffice\nAdministradores" as BOADM
  rectangle "<<subsystem>>\nFiscalizacion\nAutomatica" as FISCA
}

' =========================== subsistemas externos ===========================
rectangle "<<subsystem>>\nNodo Periferico\nBalanzas" as NBAL
rectangle "<<subsystem>>\nNodo Periferico\nTracking" as NTRK
rectangle "<<subsystem>>\nSimulador PDI" as SPDI
rectangle "<<actor>>\nUsuario gub.uy" as GUB

' grilla 3x2 dentro del central, como en la Figura 4
FOPUB -[hidden]right- FOEMP
FOEMP -[hidden]right- FOFIS
FOPUB -[hidden]down- BOAUT
BOAUT -[hidden]right- BOADM
BOADM -[hidden]right- FISCA

' =========================== asociaciones ===========================
PUB --> FOPUB
RESP --> FOEMP
FUNC --> FOFIS
AUT --> BOAUT
ADM --> BOADM
CHOF --> MOV

MOV --> CENTRAL
NBAL --> CENTRAL
NTRK --> CENTRAL
SPDI --> CENTRAL
GUB --> CENTRAL

@enduml
